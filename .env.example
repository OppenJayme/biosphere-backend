PORT=3001

# Prisma connection strings. DATABASE_URL is the pooled connection used at
# runtime; DIRECT_URL bypasses the pooler for migrations.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Origin of the frontend app. Used to build redirect URLs for Supabase auth
# emails (invite, password reset) and the record link in curator alert emails,
# so it must be publicly reachable by the recipient's browser, not a
# Docker/internal hostname.
FRONTEND_URL=http://localhost:3000

# Visitor-facing site encoded in exhibit QR codes and printed labels as
# ${PUBLIC_SITE_URL}/exhibits/<slug>. Set it to the production domain before
# printing any label. Falls back to FRONTEND_URL.
PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated browser origins allowed by CORS (public site and curator
# PWA), e.g. https://biosphere.example,https://curator.biosphere.example.
# Falls back to FRONTEND_URL when unset.
CORS_ORIGINS=http://localhost:3000

SUPABASE_URL=https://your-project.supabase.co

# Service-role key. Full-privilege — bypasses Row Level Security. Used only
# for the shared, stateless SUPABASE_CLIENT (Admin/Storage operations).
# Never expose this to a client or use it for password-based login.
SUPABASE_SECRET_KEY=

# Public anon key. Used to create a fresh, isolated Supabase client per
# login request (see src/supabase/supabase-auth-client.factory.ts) so a
# caller's session can never leak into the shared service-role client.
SUPABASE_ANON_KEY=

# Brevo transactional email for visitor notifications (submission receipts,
# approve / decline / cancel, inquiry replies, visit-request messages) and
# curator alerts for new submissions. Create an API key in Brevo
# under SMTP & API > API Keys. MAIL_FROM_EMAIL must be a sender verified in
# Brevo. Leave empty to skip sending (emails are logged as NOT_SENT).
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=USC Biological Museum

# Authorized curator recipients for new-submission alert emails (SRS
# REQ-4.8-08, REQ-4.9-07), comma-separated. Leave empty to alert every active
# curator account at its login email.
CURATOR_ALERT_EMAILS=
# Opt-in FAQ review stays off until migration, RLS, privacy and scheduled purge are verified.
FAQ_REVIEW_ENABLED=false
# Dedicated least-privilege cleanup connection; do not put credentials in this template.
FAQ_REVIEW_CLEANUP_DATABASE_URL=
# Enable only after the user_notification_state migration is deployed and verified.
NOTIFICATION_STATE_ENABLED=false
# Internal synthetic recovery bookkeeping only; no runner, exports or scheduler is enabled.
RECOVERY_HISTORY_RECORDING_ENABLED=false
# Non-personal technical operator slug, required when recording is explicitly enabled.
RECOVERY_HISTORY_OPERATOR_ID=

# Optional AI wording for the public FAQ Assistant (off by default).
# Keep CHATBOT_AI_ENABLED=false on any public deployment until the provider
# terms (18+ audience, free-tier data use) and university approvals are
# documented. See docs/FAQ_KNOWLEDGE_GUIDE.md. Never commit a real key.
CHATBOT_AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
CHATBOT_AI_MAX_PER_CLIENT_PER_HOUR=10
CHATBOT_AI_DAILY_LIMIT=200
CHATBOT_AI_TIMEOUT_MS=8000
