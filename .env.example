# Copy to .env and fill in. Nothing here is required yet — the inquiries
# and visit-requests modules currently use an in-memory store and don't
# read any of these. They become required once Prisma/Supabase are wired up.

PORT=3000
FRONTEND_URL=http://localhost:3000

