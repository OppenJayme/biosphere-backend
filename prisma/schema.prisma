generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection URLs no longer live here.
  // - CLI (generate/migrate) reads the URL from prisma.config.ts
  // - PrismaClient reads it via a driver adapter (see src/prisma/prisma.service.ts)
}

// ---------------------------------------------------------------------------
// Enums (mirrors database/sql/*.sql CREATE TYPE statements)
// ---------------------------------------------------------------------------

enum UserRole {
  CURATOR
  DEVELOPER

  @@map("user_role")
}

enum AccountStatus {
  ACTIVE
  INACTIVE

  @@map("account_status")
}

enum SpecimenStatus {
  UNCATALOGED
  CATALOGED
  ARCHIVED

  @@map("specimen_status")
}

enum SpecimenGender {
  MALE
  FEMALE
  UNKNOWN
  NOT_APPLICABLE

  @@map("specimen_gender")
}

enum QrExhibitStatus {
  UNPUBLISHED
  PUBLISHED
  DISABLED

  @@map("qr_exhibit_status")
}

enum AuditResult {
  SUCCESS
  FAILED
  DENIED

  @@map("audit_result")
}

// ---------------------------------------------------------------------------
// Models (mirrors database/sql/001_user_account.sql, 003, 005, 014, 021, 023V2)
// ---------------------------------------------------------------------------

model UserAccount {
  id         String        @id @default(uuid()) @db.Uuid
  authUserId String        @unique @map("auth_user_id") @db.Uuid
  fullName   String        @map("full_name")
  role       UserRole
  status     AccountStatus
  avatarPath String?       @map("avatar_path")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime      @default(now()) @map("updated_at") @db.Timestamptz

  createdSpecimens  Specimen[] @relation("SpecimenCreatedBy")
  updatedSpecimens  Specimen[] @relation("SpecimenUpdatedBy")
  archivedSpecimens Specimen[] @relation("SpecimenArchivedBy")
  exhibits          Exhibit[]
  auditLogs         AuditLog[]

  @@map("user_account")
}

model Collection {
  id             String   @id @default(uuid()) @db.Uuid
  collectionName String   @map("collection_name")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz

  specimens Specimen[]

  @@map("collection")
}

model Specimen {
  id                    String         @id @default(uuid()) @db.Uuid
  collectionId          String?        @map("collection_id") @db.Uuid
  createdById           String         @map("created_by") @db.Uuid
  updatedById           String?        @map("updated_by") @db.Uuid
  archivedById          String?        @map("archived_by") @db.Uuid
  accessionNumber       String?        @map("accession_number")
  specimenCategory       String?       @map("specimen_category")
  scientificName        String?        @map("scientific_name")
  commonName            String?        @map("common_name")
  gender                SpecimenGender?
  classificationStatus  String?        @map("classification_status")
  status                SpecimenStatus @default(UNCATALOGED)
  publicDisplayAllowed  Boolean        @default(false) @map("public_display_allowed")
  remarks               String?
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime       @default(now()) @map("updated_at") @db.Timestamptz
  archivedAt            DateTime?      @map("archived_at") @db.Timestamptz

  collection Collection?  @relation(fields: [collectionId], references: [id])
  createdBy  UserAccount  @relation("SpecimenCreatedBy", fields: [createdById], references: [id])
  updatedBy  UserAccount? @relation("SpecimenUpdatedBy", fields: [updatedById], references: [id])
  archivedBy UserAccount? @relation("SpecimenArchivedBy", fields: [archivedById], references: [id])
  exhibits   Exhibit[]

  @@index([collectionId])
  @@index([status])
  @@map("specimen")
}

model Exhibit {
  id                String          @id @default(uuid()) @db.Uuid
  specimenId        String          @map("specimen_id") @db.Uuid
  createdById       String          @map("created_by") @db.Uuid
  publicSlug        String          @unique @map("public_slug")
  interestingFacts  String?         @map("interesting_facts")
  publicDescription String?         @map("public_description")
  distribution      String?
  diet              String?
  layoutType        String?         @map("layout_type")
  status            QrExhibitStatus @default(UNPUBLISHED)
  publishedAt       DateTime?       @map("published_at") @db.Timestamptz
  archivedAt        DateTime?       @map("archived_at") @db.Timestamptz
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime        @default(now()) @map("updated_at") @db.Timestamptz

  specimen  Specimen    @relation(fields: [specimenId], references: [id])
  createdBy UserAccount @relation(fields: [createdById], references: [id])
  arAssets  ArAsset[]

  @@index([specimenId])
  @@index([status])
  @@map("exhibit")
}

// Reflects 023_ar_asset.sql as amended by 023_ar_assetV2.sql
// (specimen_id dropped in favor of exhibit_id).
model ArAsset {
  id          String  @id @default(uuid()) @db.Uuid
  exhibitId   String  @map("exhibit_id") @db.Uuid
  modelUrl    String  @map("model_url")
  modelFormat String  @map("model_format")
  isEnabled   Boolean @default(false) @map("is_enabled")

  exhibit Exhibit @relation(fields: [exhibitId], references: [id])

  @@index([exhibitId])
  @@map("ar_asset")
}

model AuditLog {
  id                  String      @id @default(uuid()) @db.Uuid
  userId              String?     @map("user_id") @db.Uuid
  affectedRecordId    String?     @map("affected_record_id") @db.Uuid
  affectedRecordType  String?     @map("affected_record_type")
  action              String
  module              String
  details             Json?
  status              AuditResult
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz

  user UserAccount? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([affectedRecordType, affectedRecordId])
  @@map("audit_log")
}
